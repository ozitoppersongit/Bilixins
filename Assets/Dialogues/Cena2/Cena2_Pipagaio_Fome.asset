  m_Script: {fileID: 11500000, guid: e61313f2065207a4bb061dbb5d3e66ef, type: 3}
  m_Name: Cena2_Pipagaio_Fome
  m_EditorClassIdentifier: Assembly-CSharp::DialogoData
  id: Cena2_Pipagaio_Fome
  falas:
  - nomePersonagem: ...
    texto: (Pipagaio cai, cansada.)
    portraitEsquerdo: {fileID: 0}
    portraitDireito: {fileID: 0}
    personagemFalando: 1
  - nomePersonagem: Galego
    texto: "Hum?! Ei, voc\xEA t\xE1 bem?"
    portraitEsquerdo: {fileID: 0}
    portraitDireito: {fileID: 0}
    personagemFalando: 1
  - nomePersonagem: Pipagaio
    texto: "Foi mal, \xE9 que eu t\xF4 faminta... Voc\xEA n\xE3o teria algo de pl\xE1stico pra eu comer, teria?"
    portraitEsquerdo: {fileID: 0}
    portraitDireito: {fileID: 0}
    personagemFalando: 0
  - nomePersonagem: Galego
    texto: "Ah, eu tenho, sim. Peguei algumas garrafas no caminho pra c\xE1. Toma."
    portraitEsquerdo: {fileID: 0}
    portraitDireito: {fileID: 0}
    personagemFalando: 1
  - nomePersonagem: ...
    texto: "(Pipagaio come as garrafas de pl\xE1stico e se recupera.)"
    portraitEsquerdo: {fileID: 0}
    portraitDireito: {fileID: 0}
    personagemFalando: 1
  - nomePersonagem: Pipagaio
    texto: Valeu Galego. Posso pensar direito agora.
    portraitEsquerdo: {fileID: 0}
    portraitDireito: {fileID: 0}
    personagemFalando: 0
