%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e61313f2065207a4bb061dbb5d3e66ef, type: 3}
  m_Name: Cena2_Missoes_Pipagaio_Evandro
  m_EditorClassIdentifier: Assembly-CSharp::DialogoData
  id: Cena2_Missoes_Pipagaio_Evandro
  falas:
  - nomePersonagem: Pipagaio
    texto: Acredito que quem atacou os moradores da Comunidade tenham sido os meus amigos.
    portraitEsquerdo: {fileID: 0}
    portraitDireito: {fileID: 0}
    personagemFalando: 1
  - nomePersonagem: Pipagaio
    texto: "N\xF3s fugimos da f\xE1brica que fica aqui perto. Aquele homem estranho estava l\xE1, e ele parecia estar fazendo algo assustador l\xE1 dentro."
    portraitEsquerdo: {fileID: 0}
    portraitDireito: {fileID: 0}
    personagemFalando: 1
  - nomePersonagem: Pipagaio
    texto: "Ele estava querendo nos usar para realizar algum plano maluco, mas acabou se descuidando, e eu e meus amigos conseguimos criar uma como\xE7\xE3o l\xE1 dentro e fugir. Agora ele t\xE1 vindo atr\xE1s de n\xF3s."
    portraitEsquerdo: {fileID: 0}
    portraitDireito: {fileID: 0}
    personagemFalando: 1
  - nomePersonagem: Pipagaio
    texto: "Quando fugimos, eu tive sorte de encontrar comida assim que sa\xED da f\xE1brica, mas talvez meus amigos n\xE3o tenham tido essa mesma sorte."
    portraitEsquerdo: {fileID: 0}
    portraitDireito: {fileID: 0}
    personagemFalando: 1
  - nomePersonagem: Pipagaio
    texto: "E, se isso acontecer, com certeza eles v\xE3o causar problemas por aqui."
    portraitEsquerdo: {fileID: 0}
    portraitDireito: {fileID: 0}
    personagemFalando: 1
  - nomePersonagem: Pipagaio
    texto: "Galego, n\xE9? Olha, muito obrigada por me ajudar, mas ser\xE1 que voc\xEA poderia me dar uma pra encontrar meus amigos? Eles podem estar precisando da sua ajuda tamb\xE9m."
    portraitEsquerdo: {fileID: 0}
    portraitDireito: {fileID: 0}
    personagemFalando: 1
  - nomePersonagem: Evandro
    texto: "Eu tamb\xE9m gostaria de te pedir pra dar uma olhada no pessoal da Comunidade."
    portraitEsquerdo: {fileID: 0}
    portraitDireito: {fileID: 0}
    personagemFalando: 0
  - nomePersonagem: Evandro
    texto: "A maioria t\xE1 trancada dentro de casa, mas sempre tem um ou outro teimoso ou teimosa fazendo algo que pode ser perigoso."
    portraitEsquerdo: {fileID: 0}
    portraitDireito: {fileID: 0}
    personagemFalando: 0
  - nomePersonagem: Evandro
    texto: "Se esse for o caso, eu queria que voc\xEA os ajudasse a lidar com esses tais Bilixins."
    portraitEsquerdo: {fileID: 0}
    portraitDireito: {fileID: 0}
    personagemFalando: 0
  - nomePersonagem: Galego
    texto: Okay, okay! Pode deixar que o pai vai resolver essa bronca. Vamo nessa, Pipagaio!
    portraitEsquerdo: {fileID: 0}
    portraitDireito: {fileID: 0}
    personagemFalando: 1
