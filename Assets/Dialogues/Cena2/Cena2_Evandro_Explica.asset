--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e61313f2065207a4bb061dbb5d3e66ef, type: 3}
  m_Name: Cena2_Evandro_Explica
  m_EditorClassIdentifier: Assembly-CSharp::DialogoData
  id: Cena2_Evandro_Explica
  falas:
  - nomePersonagem: Galego
    texto: "Okay, voc\xEA pode me explicar o que t\xE1 acontecendo aqui?"
    portraitEsquerdo: {fileID: 0}
    portraitDireito: {fileID: 0}
    personagemFalando: 1
  - nomePersonagem: Evandro
    texto: "Eu posso explicar, pelo menos o que eu vi. Durante a madrugada, houve uma como\xE7\xE3o na Comunidade."
    portraitEsquerdo: {fileID: 0}
    portraitDireito: {fileID: 0}
    personagemFalando: 0
  - nomePersonagem: Evandro
    texto: "Alguns moradores tavam reclamando de uma movimenta\xE7\xE3o estranha perto do lixo, e alguns tavam falando que foram atacados pelo lixo."
    portraitEsquerdo: {fileID: 0}
    portraitDireito: {fileID: 0}
    personagemFalando: 0
  - nomePersonagem: Evandro
    texto: "Claro que n\xE3o acreditamos e deixamos isso de lado, mas, pela manh\xE3, nos deparamos com a Comunidade invadida por monstros de lixo."
    portraitEsquerdo: {fileID: 0}
    portraitDireito: {fileID: 0}
    personagemFalando: 0
  - nomePersonagem: Pipagaio
    texto: "N\xE3o somos monstros. Somos Bilixins."
    portraitEsquerdo: {fileID: 0}
    portraitDireito: {fileID: 0}
    personagemFalando: 1
