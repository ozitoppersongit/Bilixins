  m_Script: {fileID: 11500000, guid: e61313f2065207a4bb061dbb5d3e66ef, type: 3}
  m_Name: Cena4_Galego_Pedido
  m_EditorClassIdentifier: Assembly-CSharp::DialogoData
  id: Cena4_Galego_Pedido
  falas:
  - nomePersonagem: Galego
    texto: "Fa\xE7am o seguinte: voc\xEAs ajudaram bastante separando e trazendo essas garrafas de vidro pra mim. Ser\xE1 que voc\xEAs podem fazer isso de novo? Deixem separado todo lixo de vidro que voc\xEAs encontrarem."
    portraitEsquerdo: {fileID: 0}
    portraitDireito: {fileID: 0}
    personagemFalando: 1
  - nomePersonagem: Galego
    texto: "Se estiver quebrado, chamem um adulto para ajudar e tomem cuidado. Dessa forma, se eu encontrar outro Bilixin de vidro, posso vir aqui conseguir mais vidro para acalm\xE1-lo."
    portraitEsquerdo: {fileID: 0}
    portraitDireito: {fileID: 0}
    personagemFalando: 1
  - nomePersonagem: Marcelo
    texto: Pode deixar com a gente!
    portraitEsquerdo: {fileID: 0}
    portraitDireito: {fileID: 0}
    personagemFalando: 0
