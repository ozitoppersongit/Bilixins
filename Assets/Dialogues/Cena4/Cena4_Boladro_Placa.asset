  m_Name: Cena4_Boladro_Placa
  m_EditorClassIdentifier: Assembly-CSharp::DialogoData
  id: Cena4_Boladro_Placa
  falas:
  - nomePersonagem: Boladro
    texto: "Ai... algu\xE9m anotou a placa do que me bateu...?"
    portraitEsquerdo: {fileID: 0}
    portraitDireito: {fileID: 0}
    personagemFalando: 0
  - nomePersonagem: Pipagaio
    texto: "Foi mal, \xE9 que voc\xEA tava fora de controle."
    portraitEsquerdo: {fileID: 0}
    portraitDireito: {fileID: 0}
    personagemFalando: 1
  - nomePersonagem: Boladro
    texto: "Pipagaio...? N\xE3o me surpreende que voc\xEA esteja bem... Tem muito mais pl\xE1stico jogado por a\xED do que os outros tipos de lixo..."
    portraitEsquerdo: {fileID: 0}
    portraitDireito: {fileID: 0}
    personagemFalando: 0
  - nomePersonagem: Caio
    texto: "Eu n\xE3o entendo. Por que o Boladro ficou descontrolado e a Pipagaio t\xE1 bem?"
    portraitEsquerdo: {fileID: 0}
    portraitDireito: {fileID: 0}
    personagemFalando: 0
