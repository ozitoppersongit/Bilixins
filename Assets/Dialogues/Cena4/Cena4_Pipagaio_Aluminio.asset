  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e61313f2065207a4bb061dbb5d3e66ef, type: 3}
  m_Name: Cena4_Pipagaio_Aluminio
  m_EditorClassIdentifier: Assembly-CSharp::DialogoData
  id: Cena4_Pipagaio_Aluminio
  falas:
  - nomePersonagem: Pipagaio
    texto: "Calma a\xED, garoto. Eu posso comer garrafas de pl\xE1stico, mas n\xE3o esses sacos de salgadinhos e biscoitos que voc\xEA falou."
    portraitEsquerdo: {fileID: 0}
    portraitDireito: {fileID: 0}
    personagemFalando: 1
  - nomePersonagem: Michele
    texto: "Por que n\xE3o? Eles n\xE3o s\xE3o de pl\xE1stico tamb\xE9m?"
    portraitEsquerdo: {fileID: 0}
    portraitDireito: {fileID: 0}
    personagemFalando: 0
  - nomePersonagem: Galego
    texto: "\xC9 que esses sacos n\xE3o s\xE3o feitos s\xF3 de pl\xE1stico. Tem alum\xEDnio neles tamb\xE9m. \xC9 por esse mesmo motivo que voc\xEA n\xE3o deve coloc\xE1-los junto de outros pl\xE1sticos para reciclar."
    portraitEsquerdo: {fileID: 0}
    portraitDireito: {fileID: 0}
    personagemFalando: 1
  - nomePersonagem: Marcelo
    texto: "O Boladro agora est\xE1 bem, mas, pelo que a Pipagaio disse, ela tem mais amigos soltos por a\xED. E se eles tamb\xE9m estiverem que nem o Boladro, pode ser que acabem atacando algu\xE9m."
    portraitEsquerdo: {fileID: 0}
    portraitDireito: {fileID: 0}
    personagemFalando: 0
  - nomePersonagem: Michele
    texto: Galego, tem alguma coisa que a gente possa fazer pra ajudar?
    portraitEsquerdo: {fileID: 0}
    portraitDireito: {fileID: 0}
    personagemFalando: 0
