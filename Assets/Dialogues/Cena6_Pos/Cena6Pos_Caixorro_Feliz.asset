  falas:
  - nomePersonagem: Caixorro
    texto: "Fico feliz em ver gente com considera\xE7\xE3o e respeito pelo local onde moram, se ele ainda quiser ajudar eu ficaria mais que feliz em t\xEA-lo comigo."
