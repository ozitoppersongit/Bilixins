  id: Cena3_Criancas_Medo
  falas:
  - nomePersonagem: ???
    texto: "Marcelo, eu n\xE3o acho que a gente devia ir muito pra perto do lixo. E se o monstro pular na gente?"
    portraitEsquerdo: {fileID: 0}
    portraitDireito: {fileID: 0}
    personagemFalando: 0
  - nomePersonagem: Marcelo
    texto: "Relaxa, Caio. Eu protejo voc\xEAs. N\xE3o tenho medo de nada, lembra?"
    portraitEsquerdo: {fileID: 0}
    portraitDireito: {fileID: 0}
    personagemFalando: 1
  - nomePersonagem: ???
    texto: "S\xF3 da mam\xE3e, morcegos e aranhas."
    portraitEsquerdo: {fileID: 0}
    portraitDireito: {fileID: 0}
    personagemFalando: 0
  - nomePersonagem: Marcelo
    texto: "Ei, Michele, eu te disse pra n\xE3o contar isso pra ningu\xE9m!"
    portraitEsquerdo: {fileID: 0}
    portraitDireito: {fileID: 0}
    personagemFalando: 1
