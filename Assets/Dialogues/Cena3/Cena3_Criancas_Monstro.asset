  m_Name: Cena3_Criancas_Monstro
  m_EditorClassIdentifier: Assembly-CSharp::DialogoData
  id: Cena3_Criancas_Monstro
  falas:
  - nomePersonagem: "Crian\xE7as"
    texto: MONSTRO!!!
    portraitEsquerdo: {fileID: 0}
    portraitDireito: {fileID: 0}
    personagemFalando: 0
  - nomePersonagem: ...
    texto: (Elas dizem, apontando para Pipagaio.)
    portraitEsquerdo: {fileID: 0}
    portraitDireito: {fileID: 0}
    personagemFalando: 0
  - nomePersonagem: Galego
    texto: "Relaxa a\xED, galera. Ela t\xE1 comigo, \xE9 minha amiga."
    portraitEsquerdo: {fileID: 0}
    portraitDireito: {fileID: 0}
    personagemFalando: 1
  - nomePersonagem: Pipagaio
    texto: "E n\xE3o sou um monstro. Me chamo Pipagaio"
    portraitEsquerdo: {fileID: 0}
    portraitDireito: {fileID: 0}
    personagemFalando: 1
  - nomePersonagem: Michele
    texto: "Dona Pipa, voc\xEA n\xE3o vai correr atr\xE1s da gente pra nos devorar, vai?"
    portraitEsquerdo: {fileID: 0}
    portraitDireito: {fileID: 0}
    personagemFalando: 0
  - nomePersonagem: Pipagaio
    texto: "Qu\xEA? Eu n\xE3o! Voc\xEAs n\xE3o s\xE3o de pl\xE1stico. Por que eu tentaria devorar voc\xEAs?"
    portraitEsquerdo: {fileID: 0}
    portraitDireito: {fileID: 0}
    personagemFalando: 1
