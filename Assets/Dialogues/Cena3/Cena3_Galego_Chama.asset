--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e61313f2065207a4bb061dbb5d3e66ef, type: 3}
  m_Name: Cena3_Galego_Chama
  m_EditorClassIdentifier: Assembly-CSharp::DialogoData
  id: Cena3_Galego_Chama
  falas:
  - nomePersonagem: ...
    texto: (Galego se aproxima e fala com elas.)
    portraitEsquerdo: {fileID: 0}
    portraitDireito: {fileID: 0}
    personagemFalando: 0
  - nomePersonagem: Galego
    texto: "Oh, galerinha, voc\xEAs sabem que n\xE3o \xE9 pra ficar fora de casa, n\xE9?"
    portraitEsquerdo: {fileID: 0}
    portraitDireito: {fileID: 0}
    personagemFalando: 1
  - nomePersonagem: Galego
    texto: "O que voc\xEAs est\xE3o fazendo a\xED?"
    portraitEsquerdo: {fileID: 0}
    portraitDireito: {fileID: 0}
    personagemFalando: 1
  - nomePersonagem: Marcelo
    texto: "Ei, olha l\xE1, \xE9 o Galego! Ei, chega mais, tem um monstro escondido aqui."
    portraitEsquerdo: {fileID: 0}
    portraitDireito: {fileID: 0}
    personagemFalando: 0
  - nomePersonagem: ...
    texto: (O garoto do meio sussurra.)
    portraitEsquerdo: {fileID: 0}
    portraitDireito: {fileID: 0}
    personagemFalando: 0
  - nomePersonagem: Galego
    texto: "Ent\xE3o n\xE3o seriam voc\xEAs que teriam que sair da\xED?"
    portraitEsquerdo: {fileID: 0}
    portraitDireito: {fileID: 0}
    personagemFalando: 1
  - nomePersonagem: Galego
    texto: Venham aqui.
    portraitEsquerdo: {fileID: 0}
    portraitDireito: {fileID: 0}
    personagemFalando: 1
  - nomePersonagem: ...
    texto: "(As crian\xE7as v\xE3o at\xE9 Galego.)"
    portraitEsquerdo: {fileID: 0}
    portraitDireito: {fileID: 0}
    personagemFalando: 1
  - nomePersonagem: Galego
    texto: "P\xF4, Marcelinho, achei que voc\xEA era mais esperto que isso. Vai deixar tua irm\xE3zinha e teu amigo ficarem perto de um bicho que pode machucar voc\xEAs?"
    portraitEsquerdo: {fileID: 0}
    portraitDireito: {fileID: 0}
    personagemFalando: 1
  - nomePersonagem: Pipagaio
    texto: "Bicho, n\xE3o. Bilixin, meu amigo."
    portraitEsquerdo: {fileID: 0}
    portraitDireito: {fileID: 0}
    personagemFalando: 0
