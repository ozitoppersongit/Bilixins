  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e61313f2065207a4bb061dbb5d3e66ef, type: 3}
  m_Name: Cena3_Marcelo_Boladro
  m_EditorClassIdentifier: Assembly-CSharp::DialogoData
  id: Cena3_Marcelo_Boladro
  falas:
  - nomePersonagem: Marcelo
    texto: "Ele parecia bem de boa. Era uma bola de futebol com um monte de vidro e garrafas presas nela, mas agora ele se enfiou naquela pilha de lixo e t\xE1 fazendo uns barulhos estranhos."
    portraitEsquerdo: {fileID: 0}
    portraitDireito: {fileID: 0}
    personagemFalando: 0
  - nomePersonagem: Pipagaio
    texto: "Isso n\xE3o \xE9 bom. Deve ser o Boladro. Ele \xE9 um Bilixin de vidro. Galego, precisamos alimentar ele com vidro ou isso pode sair do controle."
    portraitEsquerdo: {fileID: 0}
    portraitDireito: {fileID: 0}
    personagemFalando: 1
  - nomePersonagem: Galego
    texto: "T\xE1, mas eu n\xE3o tenho vidro comigo agora."
    portraitEsquerdo: {fileID: 0}
    portraitDireito: {fileID: 0}
    personagemFalando: 1
  - nomePersonagem: Marcelo
    texto: "Deixa com a gente. Eu posso conseguir umas garrafas e trazer pra c\xE1. Vamos, pessoal. Galego, n\xE3o tira o olho do monstro."
    portraitEsquerdo: {fileID: 0}
    portraitDireito: {fileID: 0}
    personagemFalando: 0
