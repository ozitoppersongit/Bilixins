  m_Script: {fileID: 11500000, guid: e61313f2065207a4bb061dbb5d3e66ef, type: 3}
  m_Name: Cena6_Danilo_Puxando
  m_EditorClassIdentifier: Assembly-CSharp::DialogoData
  id: Cena6_Danilo_Puxando
  falas:
  - nomePersonagem: Danilo
    texto: "Bilixin? Eu teria escolhido um nome mais legal\u2026"
    portraitEsquerdo: {fileID: 0}
    portraitDireito: {fileID: 0}
    personagemFalando: 0
  - nomePersonagem: Pipagaio
    texto: Danilo...
    portraitEsquerdo: {fileID: 0}
    portraitDireito: {fileID: 0}
    personagemFalando: 1
  - nomePersonagem: Danilo
    texto: "Oh, certo, ele parecia um cachorro feito de caixas de papel\xE3o."
    portraitEsquerdo: {fileID: 0}
    portraitDireito: {fileID: 0}
    personagemFalando: 0
  - nomePersonagem: Pipagaio
    texto: "\xC9 o Caixorro."
    portraitEsquerdo: {fileID: 0}
    portraitDireito: {fileID: 0}
    personagemFalando: 1
  - nomePersonagem: Danilo
    texto: "S\xE9rio? Caixorro? Esse foi o nome do Bilixin que parece um cachorro feito de caixas?"
    portraitEsquerdo: {fileID: 0}
    portraitDireito: {fileID: 0}
    personagemFalando: 0
  - nomePersonagem: Pipagaio
    texto: "Ei, n\xE3o reclame comigo, n\xE3o fui eu que escolhi os nossos nomes."
    portraitEsquerdo: {fileID: 0}
    portraitDireito: {fileID: 0}
    personagemFalando: 1
