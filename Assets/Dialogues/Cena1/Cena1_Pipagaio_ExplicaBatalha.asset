%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e61313f2065207a4bb061dbb5d3e66ef, type: 3}
  m_Name: Cena1_Pipagaio_ExplicaBatalha
  m_EditorClassIdentifier: Assembly-CSharp::DialogoData
  id: Cena1_Pipagaio_ExplicaBatalha
  falas:
  - nomePersonagem: Galego
    texto: "Ei, amigo, que bicho \xE9 esse?"
    portraitEsquerdo: {fileID: 0}
    portraitDireito: {fileID: 0}
    personagemFalando: 1
  - nomePersonagem: "??? (Vil\xE3o)"
    texto: "Qu\xEA? Vai cuidar da tua vida, catador de lixo! N\xE3o t\xE1 vendo que eu t\xF4 ocupado?"
    portraitEsquerdo: {fileID: 0}
    portraitDireito: {fileID: 0}
    personagemFalando: 0
  - nomePersonagem: Galego
    texto: "Sou catador de recicl\xE1veis, e com muito orgulho, pra sua informa\xE7\xE3o! E deixa o papagaio em paz. J\xE1 vi que voc\xEA n\xE3o \xE9 flor que se cheire."
    portraitEsquerdo: {fileID: 0}
    portraitDireito: {fileID: 0}
    personagemFalando: 1
  - nomePersonagem: ??? (Pipagaio)
    texto: "\xC9 Pipagaio pra voc\xEA, t\xE1?"
    portraitEsquerdo: {fileID: 0}
    portraitDireito: {fileID: 0}
    personagemFalando: 0
  - nomePersonagem: "??? (Vil\xE3o)"
    texto: "Voc\xEA fica fora disso, catador! N\xE3o t\xE1 vendo que eu t\xF4 tentando livrar a Comunidade desse Bilixin?"
    portraitEsquerdo: {fileID: 0}
    portraitDireito: {fileID: 0}
    personagemFalando: 0
  - nomePersonagem: Galego
    texto: Bilixin?
    portraitEsquerdo: {fileID: 0}
    portraitDireito: {fileID: 0}
    personagemFalando: 1
  - nomePersonagem: Pipagaio
    texto: "\xC9 o que eu sou. Esse cara t\xE1 cheio das ideias erradas. Me ajuda, mo\xE7o."
    portraitEsquerdo: {fileID: 0}
    portraitDireito: {fileID: 0}
    personagemFalando: 0
  - nomePersonagem: Galego
    texto: Pode me chamar de Galego, e pode contar comigo!
    portraitEsquerdo: {fileID: 0}
    portraitDireito: {fileID: 0}
    personagemFalando: 1
  - nomePersonagem: "??? (Vil\xE3o)"
    texto: "T\xE1 querendo ficar no meu caminho? Beleza, ent\xE3o \xE9 melhor se preparar!"
    portraitEsquerdo: {fileID: 0}
    portraitDireito: {fileID: 0}
    personagemFalando: 0
